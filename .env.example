# =============================================================================
# Servidor
# =============================================================================
PORT=8020

# Timezone do container (garante que o horário coletado e exibido seja o horário local)
TZ=America/Sao_Paulo

# =============================================================================
# Banco de dados SQLite
# Caminho dentro do container (mapeado pelo volume ./data:/data)
# =============================================================================
DB_PATH=/data/speed_tests.db

# =============================================================================
# Configuração de WANs e intervalo de coleta
# A partir desta versão, WANs (servidor Ookla, nomes, limites de alerta, cor)
# e o intervalo do cron NÃO são mais configurados por variável de ambiente —
# use a tela de Configurações (ícone ⚙️) na própria aplicação web. Essas
# configurações ficam persistidas no banco SQLite (tabelas `wans` e
# `app_settings`).
#
# Se você está atualizando a partir de uma versão anterior que usava
# WAN1_*/WAN2_*/CRON_INTERVAL neste arquivo, os valores existentes são
# migrados automaticamente para o banco na primeira subida após a
# atualização — pode remover essas linhas do seu .env depois disso.
# =============================================================================
